<?xml version="1.0"?>
<robot name="omni_wheel_robot">
    
    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.5 0.5 0.2"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>
    
    <joint name="base_to_wheel1" type="fixed">
        <parent link="base_link"/>
        <child link="wheel1"/>
        <origin xyz="-0.25 0.25 0.1" rpy="0 0 0"/>
    </joint>

    <joint name="base_to_wheel2" type="fixed">
        <parent link="base_link"/>
        <child link="wheel2"/>
        <origin xyz="0.25 0.25 0.1" rpy="0 0 0"/>
    </joint>

    <joint name="base_to_wheel3" type="fixed">
        <parent link="base_link"/>
        <child link="wheel3"/>
        <origin xyz="-0.25 -0.25 0.1" rpy="0 0 0"/>
    </joint>

    <joint name="base_to_wheel4" type="fixed">
        <parent link="base_link"/>
        <child link="wheel4"/>
        <origin xyz="0.25 -0.25 0.1" rpy="0 0 0"/>
    </joint>

    <link name="wheel1">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>

    <link name="wheel2">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>

    <link name="wheel3">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>

    <link name="wheel4">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.05"/>
            </geometry>
            <material name="black"/>
        </visual>
    </link>
</robot>
